<h1>Document:</h1>
<h2><%= document.title %></h2>
<dl>
	<dt>Timestamp</dt>
    <dd><%= document.timestamp %></dd>
    <dt>Location</dt>
    <dd><%= document.location %></dd>
	<dt>Last moved</dt>
    <dd><%= document.last_moved %></dd>
</dl>
<h2>Attachments:</h2>
<ul>
	<% attachments.each do |attachment| %>
		<li><a><%= attachment.name %></a></li>
	<% end %>
</ul>