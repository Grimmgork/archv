<h1>Document:</h1>
<h2>Details:</h2>
<dl>
	<dt>Title</dt>
	<dd><%= document.title %></dd>
	<dt>Timestamp</dt>
    <dd><%= document.timestamp %></dd>
    <dt>Location</dt>
    <dd><%= document.location %></dd>
	<dt>Last moved</dt>
    <dd><%= document.last_moved %></dd>
	<dt>Id</dt>
    <dd>#<%= document.id %></dd>
</dl>
<form hx-post="/gui/document/<%= document.id %>/move">
	<label for="location">location</label>
	<input name="location" type=text/>
	<button type=submit>move</button>
</form>
<h2>Attachments:</h2>
<% unless attachments.any? %>
none
<% else %>
<ul>
	<% attachments.each do |attachment| %>
		<li><a target="_blank" href="/api/document/<%= document.id %>/attachment/<%= attachment.name %>/data"><%= attachment.name %></a></li>
	<% end %>
</ul>
<% end %>