<h1>Document:</h1>
<span style="font-weight: bold"><%= document.title %></span>
<dl>
	<dt>Created</dt>
    <dd><%= document.timestamp %></dd>
    <dt>Location</dt>
    <dd><%= document.location %></dd>
	<dt>Last moved</dt>
    <dd><%= document.last_moved %></dd>
	<dt>Id</dt>
    <dd>#<%= document.id %></dd>
</dl>
<button hx-delete="/gui/document/<%= document.id %>">delete</button>
<form hx-post="/gui/document/<%= document.id %>/updateTitle">
	<label for="title">title</label>
	<input name="title" type=text value="<%= document.title %>">
	<button type=submit>update</button>
</form>
<form hx-post="/gui/document/<%= document.id %>/move">
	<label for="location">location</label>
	<input name="location" type=text value="<%= document.location %>"/>
	<button type=submit>move</button>
</form>
<% unless attachments.any? %>
no attachments
<% else %>
<table>
	<tr>
		<th>attachment</th>
		<th>page</th>
		<th>mtime</th>
		<th>actions</th>
	</tr>
	<% attachments.each do |attachment| %>
		<tr>
			<td><a target=_blank href="/api/document/<%= document.id %>/attachment/<%= attachment.name %>/data"><%= attachment.name %></a></td>
			<td><%= attachment.page %></td>
			<td><%= attachment.mtime %></td>
			<td><button hx-delete="/gui/document/<%= document.id %>/attachment/<%= attachment.name %>">delete</button></td>
		</tr>
	<% end %>
</table>
<% end %>
<form hx-post="/gui/document/<%= document.id %>/attachment" enctype="multipart/form-data" >
	<label>data</label><br>
	<input type=file name=data><br>
	<label>name</label><br>
	<input type=text name=name><br>
	<label>page</label><br>
	<input type=number name=page min=0><br>
	<button type=submit>create</button>
</form>